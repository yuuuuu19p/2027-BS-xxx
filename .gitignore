# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---- 环境与密钥 ----
.env
*.local
*.key
*.pem

# ---- 数据（保留目录结构，.gitkeep 除外）----
data/raw/
data/processed/
*.db
*.sqlite
*.h5
*.hdf5
*.pkl
*.npz
*.onnx

# ---- 实验结果（checkpoint 不入库；实验日志 jsonl 可入库，临时 *.log 不入库）----
results/checkpoints/*
*.log
!results/checkpoints/.gitkeep
!results/logs/.gitkeep
!results/logs/*.jsonl

# ---- 论文临时文件 ----
thesis/drafts/*.bak
~$*.docx

# ---- 系统与 IDE ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- 模型权重 ----
*.pth
*.pt
*.ckpt
*.safetensors

# ---- 构建产物 / 依赖目录 ----
build/
dist/
node_modules/

# ---- Vivado / FPGA 临时文件 ----
.Xil/
*.jou
*.wdb
*.backup.jou

# ---- Conda 环境目录 ----
miniconda3/
anaconda3/

